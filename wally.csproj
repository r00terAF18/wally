<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <AssemblyName>wally</AssemblyName>
        <Version>0.2.0</Version>
        <!-- Keep the version output clean (no +commit hash suffix). -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <!-- LibraryImport (source-generated P/Invoke for the Windows setter) emits unsafe code. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Debug configuration -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <PublishTrimmed>false</PublishTrimmed>
        <PublishAot>false</PublishAot>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
        <WarningLevel>6</WarningLevel>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <!-- Release configuration -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishTrimmed>true</PublishTrimmed>
        <PublishAot>true</PublishAot>
        <DefineConstants>TRACE</DefineConstants>
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
        <WarningLevel>6</WarningLevel>
        <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>


    <ItemGroup>
        <PackageReference Include="HtmlAgilityPack" Version="1.12.2"/>
        <PackageReference Include="System.CommandLine" Version="2.0.12"/>
        <PackageReference Include="Spectre.Console" Version="0.50.0"/>
    </ItemGroup>

</Project>
